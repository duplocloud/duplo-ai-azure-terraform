locals {
  # Final records the user creates at their DNS provider. In azure_dns mode the
  # platform root creates them, so none are needed there.
  dns_records = local.platform.dns_mode == "azure_dns" || local.platform.app_gateway_public_ip == "" ? [] : [
    { name = var.deployment.host, type = "A", value = local.platform.app_gateway_public_ip },
    { name = var.deployment.xterm_host, type = "A", value = local.platform.app_gateway_public_ip },
  ]
}

output "load_balancer_hostname" {
  description = "Address the DNS records point at: on Azure the Application Gateway public IP (the name AWS and GCP use)"
  value       = local.platform.app_gateway_public_ip
}

output "helpdesk_url" {
  description = "Helpdesk URL"
  value       = "https://${var.deployment.host}"
}

output "dns_records" {
  description = "A records to create for the Helpdesk hosts; empty when Azure DNS is managed by the platform root"
  value       = local.dns_records
}

output "secrets" {
  description = "Echo of var.secrets so a takeover can read user-entered secrets back"
  value       = var.secrets
  sensitive   = true
}

output "generated" {
  description = "Secrets generated by this root"
  sensitive   = true
  value = {
    jwt_shared_secret     = random_password.jwt_shared_secret.result
    mongodb_root_password = random_password.mongodb_root_password.result
  }
}
